ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model choices
AI_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
THEME_EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0
ANTHROPIC_INPUT_COST_PER_MILLION=0
ANTHROPIC_OUTPUT_COST_PER_MILLION=0

# Production service
SUPPORTSENSE_ENV=development
SUPPORTSENSE_API_KEYS=dev-admin-key:demo-tenant:admin
SUPPORTSENSE_ROLLOUT_STAGE=limited_automation
SUPPORTSENSE_RATE_LIMIT_PER_MINUTE=120
SUPPORTSENSE_MAX_UPLOAD_BYTES=10485760
SUPPORTSENSE_MAX_TICKET_ROWS=100000
SUPPORTSENSE_CONVERSATION_WINDOW=12
DATABASE_URL=sqlite:///./supportsense.db
# REDIS_URL=redis://localhost:6379/0
# CHROMA_URL=http://localhost:8001
SUPPORTSENSE_EMBEDDING_PROVIDER=local
SUPPORTSENSE_TOOL_BACKEND=sandbox
# Production tool gateway:
# SUPPORTSENSE_TOOL_BACKEND=http
# SUPPORTSENSE_TOOL_API_URL=https://tools.internal.example.com
# SUPPORTSENSE_TOOL_API_TOKEN=

# Production OIDC/JWT verification (use Secrets Manager; do not commit values)
# SUPPORTSENSE_JWT_ISSUER=https://identity.example.com/
# SUPPORTSENSE_JWT_AUDIENCE=supportsense-api
# SUPPORTSENSE_JWT_PUBLIC_KEY=

# Optional production observability
SUPPORTSENSE_TRACES_SAMPLE_RATE=0.1
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
